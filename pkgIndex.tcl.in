# Register the core extension and optional TclOO package.
if {@BUILD_SHARED_LIBS@} {
    package ifneeded tpersist @PROJECT_VERSION@ [list load [file join $dir libtpersist[info sharedlibextension]] Tpersist]
}
package ifneeded tpersist::oo @PROJECT_VERSION@ [list source [file join $dir oo.tcl]]
