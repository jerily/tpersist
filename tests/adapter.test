# Exercise the TDBC protocol without requiring remote database services.
package require tcltest 2
package require tpersist
namespace import ::tcltest::test
namespace import ::tpersist::db_*
namespace eval ::fake {
    variable calls {}
    variable fail 0
    variable alive 0
}
oo::class create ::fake::Connection {
    method prepare {sql} {
        lappend ::fake::calls [list prepare $sql]
        ::fake::Statement new
    }
    method begintransaction {} { lappend ::fake::calls begin }
    method commit {} { lappend ::fake::calls commit }
    method rollback {} { lappend ::fake::calls rollback }
    method close {} { my destroy }
}
oo::class create ::fake::Statement {
    constructor {} { incr ::fake::alive }
    destructor { incr ::fake::alive -1 }
    method paramtype {name type} { lappend ::fake::calls [list type $name $type] }
    method execute {dictionary} {
        lappend ::fake::calls [list execute $dictionary]
        if {$::fake::fail} { return -code error -errorcode {TDBC GENERAL_ERROR HY000 FAKE 1} failed }
        ::fake::Result new
    }
    method close {} { my destroy }
}
oo::class create ::fake::Result {
    constructor {} { incr ::fake::alive }
    destructor { incr ::fake::alive -1 }
    method columns {} { return name }
    method rowcount {} { return 1 }
    method allrows {args} { return $::fake::rows }
    method close {} { my destroy }
}
# Register a test double for the selected database dialect.
proc fakeConnect {dialect} {
    set ::fake::calls {}
    set ::fake::fail 0
    set ::fake::rows {{name Alice}}
    dict set ::tpersist::connections fake [dict create command [::fake::Connection new] \
        dialect $dialect autobegin 1 transaction 0 savepoints {}]
    return fake
}

foreach {dialect quoted} {sqlite {"users"} postgresql {"users"} mysql {`users`}} {
    test adapter-bind-$dialect {dialect SQL and typed dictionary bindings go through TDBC} -setup {
        set db [fakeConnect $dialect]
    } -body {
        set s [db_where [db_select users -columns name] [db_eq [db_col age] [db_param age -type integer]]]
        set result [db_execute $db $s -params {age 21}]
        list $::fake::calls [dict get $result rows] $::fake::alive
    } -cleanup {db_disconnect $db} -result [list [list begin \
        [list prepare "SELECT [expr {$dialect eq "mysql" ? "`name`" : "\"name\""}] FROM $quoted WHERE ([expr {$dialect eq "mysql" ? "`age`" : "\"age\""}] = [expr {$dialect eq "postgresql" ? "CAST(:p1 AS BIGINT)" : ":p1"}])"] \
        {type p1 bigint} {execute {p1 21}}] {{name Alice}} 0]
}

test adapter-1.1 {explicit NULL passes an empty dictionary to TDBC} -setup {
    set db [fakeConnect postgresql]
} -body {
    db_execute $db [db_values [db_insert users] [dict create name [db_param name]] -expressions] -nulls name
    lindex $::fake::calls end
} -cleanup {db_disconnect $db} -result {execute {}}

test adapter-1.2 {driver errors retain SQLSTATE and close the statement} -setup {
    set db [fakeConnect mysql]
    set ::fake::fail 1
} -body {
    catch {db_execute $db [db_select users]} message opts
    list $message [dict get $opts -errorcode] $::fake::alive
} -cleanup {db_disconnect $db} -result {failed {TDBC GENERAL_ERROR HY000 FAKE 1} 0}

test adapter-1.3 {MySQL DDL cannot implicitly commit an active transaction} -setup {
    set db [fakeConnect mysql]
    db_begin $db
} -body {
    db_create_table $db [db_define_table users {id {type integer}}]
} -cleanup {db_disconnect $db} -returnCodes error -match glob -result {*DDL can commit implicitly*}

test adapter-1.4 {invalid compiler input never reaches TDBC} -setup {
    set db [fakeConnect postgresql]
} -body {
    catch {db_execute $db [db_update users]}
    set ::fake::calls
} -cleanup {db_disconnect $db} -result {}

test adapter-1.5 {MySQL decimal parameters reach the driver as exact text} -setup {
    set db [fakeConnect mysql]
} -body {
    # db_select numbers -columns [list [db_add [db_col big] [db_value .25 -type decimal]]]
    db_execute $db [db_select numbers -expr {big + .25}]
    set ::fake::calls
} -cleanup {db_disconnect $db} -result {begin {prepare {SELECT (`big` + CAST(:p1 AS DECIMAL(65,2))) FROM `numbers`}} {type p1 varchar} {execute {p1 .25}}}

foreach dialect {sqlite postgresql mysql} {
    test adapter-dialect-$dialect {public dialect access validates the connection lifetime} -setup {
        set db [fakeConnect $dialect]
    } -body {
        set actual [db_dialect $db]
        db_disconnect $db
        list $actual [catch {db_dialect $db} message options] [dict get $options -errorcode]
    } -result [list $dialect 1 {TPERSIST CONNECTION}]
}

foreach {dialect expected} {
    sqlite {CREATE INDEX "posts_date" ON "posts" ("domain", "published_at" DESC, "path")}
    postgresql {CREATE INDEX "posts_date" ON "posts" ("domain", "published_at" DESC, "path")}
    mysql {CREATE INDEX `posts_date` ON `posts` (`domain`, `published_at` DESC, `path`)}
} {
    test adapter-index-order-$dialect {descending index columns preserve ascending tie-break columns} -setup {
        set db [fakeConnect $dialect]
    } -body {
        db_create_index $db posts_date posts {domain published_at path} -descending published_at
        lindex $::fake::calls 0 1
    } -cleanup {db_disconnect $db} -result $expected
}

test adapter-index-validation {invalid descending columns fail before executing DDL} -setup {
    set db [fakeConnect sqlite]
} -body {
    set result {}
    foreach descending {{missing} {created_at created_at} {created_at; DROP TABLE users}} {
        lappend result [catch {db_create_index $db recent users {tenant created_at id} -descending $descending}]
    }
    lappend result $::fake::calls
    set result
} -cleanup {db_disconnect $db} -result {1 1 1 {}}

test adapter-index-quoting {quoted index columns remain identifiers when descending} -setup {
    set db [fakeConnect sqlite]
} -body {
    db_create_index $db ix users [list {created "at} id] -descending [list {created "at}]
    lindex $::fake::calls 0 1
} -cleanup {db_disconnect $db} -result {CREATE INDEX "ix" ON "users" ("created ""at" DESC, "id")}

foreach dialect {sqlite postgresql mysql} {
    foreach exists {0 1} {
        test adapter-json-schema-$dialect-$exists {apply uses native guards or MySQL catalog checks without autobegin} -setup {
            set db [fakeConnect $dialect]
            set ::fake::rows [expr {$exists ? {{present 1}} : {}}]
            set filename [file join [file dirname [info script]] sql adapter.json]
        } -body {
            db_apply_schema $db $filename
            set sqls {}
            foreach call $::fake::calls {
                if {[lindex $call 0] eq "prepare"} { lappend sqls [lindex $call 1] }
            }
            set creates [lsearch -all -inline -glob $sqls {CREATE*INDEX*}]
            list [string match {CREATE TABLE IF NOT EXISTS *} [lindex $sqls 0]] \
                [llength $creates] [expr {"begin" in $::fake::calls}] $::fake::alive
        } -cleanup {
            db_disconnect $db
        } -result [list 1 [expr {$dialect eq "mysql" && $exists ? 0 : 1}] 0 0]
    }
}

test adapter-json-mysql-qualified {MySQL catalog checks bind schema, table, and index names as data} -setup {
    set db [fakeConnect mysql]
    set filename [file join [file dirname [info script]] sql adapter-qualified.json]
} -body {
    db_apply_schema $db $filename
    list [lindex $::fake::calls 2] [lindex $::fake::calls 3]
} -cleanup {
    db_disconnect $db
} -result [list \
    {prepare {SELECT 1 AS present FROM information_schema.statistics WHERE table_schema = :schema_name AND table_name = :table_name AND index_name = :index_name LIMIT 1}} \
    {execute {table_name users'-- index_name ix'-- schema_name app'--}}]

test adapter-json-mysql-transaction {apply rejects MySQL DDL in an existing transaction before any statements} -setup {
    set db [fakeConnect mysql]
    db_begin $db
    set ::fake::calls {}
    set filename [file join [file dirname [info script]] sql adapter-transaction.json]
} -body {
    catch {db_apply_schema $db $filename} message opts
    list [dict get $opts -errorcode] $::fake::calls
} -cleanup {
    db_disconnect $db
} -result {{TPERSIST TRANSACTION} {}}

foreach fixture {preflight-index preflight-mysql} {
    test adapter-json-$fixture {late validation errors never reach TDBC} -setup {
        set db [fakeConnect mysql]
        set filename [file join [file dirname [info script]] sql $fixture.json]
    } -body {
        list [catch {db_apply_schema $db $filename}] $::fake::calls
    } -cleanup {
        db_disconnect $db
    } -result {1 {}}
}


# Catalog inspection must preserve the connection's transaction state.
foreach dialect {sqlite postgresql mysql} {
    foreach exists {0 1} {
        test adapter-json-columns-$dialect-$exists {column additions are planned only for existing tables without autobegin} -setup {
            set db [fakeConnect $dialect]
            set ::fake::rows [expr {$exists ? {{name id schema_name app}} : {}}]
            set filename [file join [file dirname [info script]] sql add-columns.json]
        } -body {
            db_apply_schema $db $filename -additive true
            set sqls {}
            foreach call $::fake::calls {
                if {[lindex $call 0] eq "prepare"} { lappend sqls [lindex $call 1] }
            }
            set alters [lsearch -all -inline -glob $sqls {ALTER TABLE*ADD COLUMN*}]
            list [llength $alters] [expr {"begin" in $::fake::calls}] $::fake::alive
        } -cleanup {db_disconnect $db} -result [list [expr {$exists ? 4 : 0}] 0 0]
    }
    test adapter-json-columns-qualified-$dialect {metadata names are bound and ALTER identifiers are separately quoted} -setup {
        set db [fakeConnect $dialect]
        set ::fake::rows [list [dict create name {x";DROP} schema_name extra]]
        set filename [file join [file dirname [info script]] sql add-columns-qualified.json]
    } -body {
        db_apply_schema $db $filename -additive true
        set sqls {}
        foreach call $::fake::calls {
            if {[lindex $call 0] eq "prepare"} { lappend sqls [lindex $call 1] }
        }
        list [lindex $::fake::calls 1] [lsearch -all -inline -glob $sqls {ALTER TABLE*}]
    } -cleanup {db_disconnect $db} -result [list \
        {execute {table_name {node table name other} schema_name extra}} \
        [list [expr {$dialect eq "mysql" ? {ALTER TABLE `extra`.`node table name other` ADD COLUMN `new"column` TEXT DEFAULT 'safe''value'} : \
            ($dialect eq "postgresql" ? {ALTER TABLE "extra"."node table name other" ADD COLUMN "new""column" TEXT DEFAULT E'safe''value'} : \
            {ALTER TABLE "extra"."node table name other" ADD COLUMN "new""column" TEXT DEFAULT 'safe''value'})}]]]
}

test adapter-json-columns-catalog-error {metadata failures propagate before any DDL and release resources} -setup {
    set db [fakeConnect mysql]
    set ::fake::fail 1
    set filename [file join [file dirname [info script]] sql add-columns.json]
} -body {
    catch {db_apply_schema $db $filename -additive true} message opts
    list [dict get $opts -errorcode] [llength $::fake::calls] $::fake::alive
} -cleanup {db_disconnect $db} -result {{TDBC GENERAL_ERROR HY000 FAKE 1} 2 0}

rename fakeConnect {}
namespace delete ::fake
::tcltest::cleanupTests
