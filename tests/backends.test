# Opt in with Tcl option lists in TPERSIST_TEST_POSTGRESQL / TPERSIST_TEST_MYSQL.
# These tests create and drop only their uniquely named tables in the supplied
# test database. Connection failure is a test failure when explicitly enabled.
package require tcltest 2
package require tpersist
namespace import ::tcltest::test
namespace import ::tpersist::db_*

proc backendSetup {dialect} {
    set options $::env(TPERSIST_TEST_[string toupper $dialect])
    set db [db_connect -dialect $dialect {*}$options]
    set table tpersist_test_[pid]_[clock clicks]
    try {
        db_create_table $db [db_define_table $table {
            id {type integer primary_key 1 auto_increment 1}
            name {type varchar length 100 not_null 1}
            big {type bigint}
            flag {type boolean}
            payload {type binary}
            note {type text}
        }]
    } on error {message opts} {
        db_disconnect $db
        return -options $opts $message
    }
    return [list $db $table]
}
proc backendCleanup {db table} {
    catch {db_rollback $db}
    try {db_drop_table $db $table -if_exists 1} finally {db_disconnect $db}
}

foreach dialect {postgresql mysql} {
    ::tcltest::testConstraint $dialect [info exists ::env(TPERSIST_TEST_[string toupper $dialect])]
    test backend-types-$dialect {typed values and NULL travel through the real driver} -constraints $dialect -setup {
        lassign [backendSetup $dialect] db table
    } -body {
        set bytes [binary decode hex 00ff014100]
        db_transaction $db {
            db_execute $db [db_values [db_insert $table] [dict create \
                name [db_value "Zoë 世界" -type text] big [db_value 9007199254740993 -type bigint] \
                flag [db_value 1 -type boolean] payload [db_value $bytes -type binary] note [db_null]] -expressions]
        }
        set row [lindex [dict get [db_execute $db [db_select $table]] rows] 0]
        list [dict get $row name] [dict get $row big] [expr {!![dict get $row flag]}] \
            [binary encode hex [dict get $row payload]] [dict exists $row note]
    } -cleanup {backendCleanup $db $table} -result {{Zoë 世界} 9007199254740993 1 00ff014100 0}

    test backend-crud-$dialect {parameter templates, updates, pagination and deletes execute} -constraints $dialect -setup {
        lassign [backendSetup $dialect] db table
    } -body {
        db_transaction $db {
            foreach name {Alice Bob Carol} { db_execute $db [db_values [db_insert $table] [dict create name $name]] }
        }
        # set s [db_where [db_select $table -columns name] [db_ne [db_col name] [db_param excluded -type text]]]
        set s [db_where [db_select $table -expr {name}] -expr {name <> :excluded}]
        # set s [db_offset [db_order_by $s name] 1]
        set s [db_offset [db_order_by $s -expr {name}] 1]
        set rows [dict get [db_execute $db $s -params {excluded Bob}] rows]
        # db_execute $db [db_where [db_values [db_update $table] {name Changed}] [db_eq [db_col name] [db_value Alice]]]
        db_execute $db [db_where [db_values [db_update $table] {name Changed}] -expr {name = 'Alice'}]
        # db_execute $db [db_where [db_delete $table] [db_eq [db_col name] [db_value Carol]]]
        db_execute $db [db_where [db_delete $table] -expr {name = 'Carol'}]
        db_commit $db
        # list $rows [dict get [db_execute $db [db_order_by [db_select $table -columns name] name]] rows]
        list $rows [dict get [db_execute $db [db_order_by [db_select $table -expr {name}] -expr {name}]] rows]
    } -cleanup {backendCleanup $db $table} -result {{{name Carol}} {{name Bob} {name Changed}}}

    test backend-transactions-$dialect {nested savepoint rollback preserves the outer transaction} -constraints $dialect -setup {
        lassign [backendSetup $dialect] db table
    } -body {
        db_transaction $db {
            db_execute $db [db_values [db_insert $table] {name Outer}]
            catch {db_transaction $db {
                db_execute $db [db_values [db_insert $table] {name Inner}]
                error abort
            }}
        }
        dict get [db_execute $db [db_select $table -columns name]] rows
    } -cleanup {backendCleanup $db $table} -result {{name Outer}}

    test backend-expressions-$dialect {parsed aggregates, decimal literals and parameters execute on the real backend} -constraints $dialect -setup {
        lassign [backendSetup $dialect] db table
    } -body {
        db_transaction $db {
            foreach {name amount flag} {Alice 1 1 Bob 2 1 Skip 3 0} {
                db_execute $db [db_values [db_insert $table] [dict create \
                    name [db_value $name -type text] big [db_value $amount -type bigint] \
                    flag [db_value $flag -type boolean]] -expressions]
            }
        }
        # db_select $table -columns [list [db_col flag] [db_alias [db_count] n] [db_alias [db_sum [db_col big]] total]]
        set s [db_select $table -expr {flag, COUNT(*) AS n, SUM(big) AS total}]
        # db_where $s [db_and [db_ge [db_col big] [db_param minimum]] [db_is_null [db_col note]]]
        set s [db_where $s -expr {big >= :minimum AND note IS NULL}]
        # db_having [db_group_by $s flag] [db_ge [db_count] [db_value 2 -type integer]]
        set s [db_having [db_group_by $s -expr {flag}] -expr {COUNT(*) >= 2}]
        # db_order_by $s [db_desc [db_col total]]
        set row [lindex [dict get [db_execute $db [db_order_by $s -expr {total DESC}] -params {minimum 1}] rows] 0]
        # db_select $table -columns [list [db_alias [db_sum [db_add [db_col big] [db_value .25 -type decimal]]] total]]
        set decimal [db_select $table -expr {SUM(big + .25) AS total}]
        # db_where $decimal [db_not [db_like [db_col name] [db_value Skip% -type text]]]
        set decimal [db_where $decimal -expr {NOT (name LIKE 'Skip%')}]
        set total [dict get [lindex [dict get [db_execute $db $decimal] rows] 0] total]
        # db_select $table -columns [list [db_alias [db_add [db_col big] [db_value 1.25e-2 -type decimal]] total]]
        set exponent [db_select $table -expr {big + 1.25e-2 AS total}]
        set exponent [db_where $exponent -expr {name = 'Alice'}]
        set small [dict get [lindex [dict get [db_execute $db $exponent] rows] 0] total]
        # db_where [db_select $table] [db_lt [db_col id] [db_value 9007199254740993 -type integer]]
        set large [db_where [db_select $table] -expr {id < 9007199254740993}]
        set count [llength [dict get [db_execute $db $large] rows]]
        list [dict get $row n] [dict get $row total] [expr {$total == 3.5}] \
            [expr {$small == 1.0125}] $count
    } -cleanup {backendCleanup $db $table} -result {2 3 1 1 3}
}

rename backendSetup {}
rename backendCleanup {}
::tcltest::cleanupTests
