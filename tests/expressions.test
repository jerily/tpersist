package require tcltest 2
package require tpersist
namespace import ::tcltest::test
namespace import ::tpersist::db_*

test expr-1.1 {parsed predicates match the existing dictionary builders} -body {
    set explicit [db_ge [db_col age] [db_value 18 -type integer]]
    expr {[db_expr {age >= 18}] eq $explicit}
} -result 1

test expr-1.2 {multiplication/division bind tighter than addition/subtraction} -body {
    set explicit [db_sub [db_add [db_col price] [db_mul [db_col tax] [db_col quantity]]] \
        [db_div [db_col discount] [db_value 2 -type integer]]]
    expr {[db_expr {price + tax * quantity - discount / 2}] eq $explicit}
} -result 1

test expr-1.3 {NOT applies to a comparison and AND binds tighter than OR} -body {
    set explicit [db_or [db_not [db_eq [db_col a] [db_value 1 -type integer]]] \
        [db_and [db_gt [db_col b] [db_value 0 -type integer]] [db_is_not_null [db_col c]]]]
    expr {[db_expr {NOT a = 1 OR b > 0 AND c IS NOT NULL}] eq $explicit}
} -result 1

test expr-1.4 {parentheses override precedence and arithmetic associates left} -body {
    # db_select data -columns [list [db_div [db_div [db_col a] [db_col b]] [db_col c]] [db_mul [db_add [db_col a] [db_col b]] [db_col c]]]
    dict get [db_compile [db_select data -expr {a / b / c, (a + b) * c}]] sql
} -result {SELECT (("a" / "b") / "c"), (("a" + "b") * "c") FROM "data"}

test expr-1.5 {keyword case is ignored while identifier case is preserved} -body {
    # db_where [db_select users] [db_and [db_eq [db_col Active] [db_value 1 -type boolean]] [db_is_null [db_col Note]]]
    dict get [db_compile [db_where [db_select users] -expr {Active = tRuE aNd Note iS nUlL}]] sql
} -result {SELECT * FROM "users" WHERE (("Active" = :p1) AND ("Note" IS NULL))}

test expr-1.6 {unary signs use existing arithmetic nodes and preserve signed limits} -body {
    list [db_expr {-9223372036854775808}] [db_expr {+9223372036854775807}] \
        [db_expr {-(age + 1)}] [db_expr {+age}]
} -result [list [db_value -9223372036854775808 -type integer] [db_value 9223372036854775807 -type integer] \
    [db_sub [db_value 0 -type integer] [db_add [db_col age] [db_value 1 -type integer]]] [db_col age]]

test expr-1.7 {numbers use SQL decimal spelling, not Tcl octal syntax} -body {
    set compiled [db_compile [db_select numbers -expr {0018, -0008, 0, -0, .5, 1., 1e3, -2.5E-2, 1234567890.123456789}]]
    list [dict get $compiled params] [dict get $compiled types]
} -result {{p1 18 p2 -8 p3 0 p4 0 p5 .5 p6 1. p7 1e3 p8 -2.5E-2 p9 1234567890.123456789} {p1 integer p2 integer p3 integer p4 integer p5 decimal p6 decimal p7 decimal p8 decimal p9 decimal}}

test expr-2.1 {quoted strings preserve escaped quotes, commas and backslashes} -body {
    dict get [db_compile [db_select users -expr {'O''Brien, Jr.', 'a\b', '', '世界'}]] params
} -result {p1 {O'Brien, Jr.} p2 {a\b} p3 {} p4 世界}

foreach {dialect expected} {
    sqlite {SELECT "u"."order", "weird`name", "a""b" AS "out col" FROM "users" AS "u"}
    postgresql {SELECT "u"."order", "weird`name", "a""b" AS "out col" FROM "users" AS "u"}
    mysql {SELECT `u`.`order`, `weird``name`, `a"b` AS `out col` FROM `users` AS `u`}
} {
    test expr-identifiers-$dialect {source quoting is decoded and then quoted for the target dialect} -body {
        # db_select [db_table users -as u] -columns [list [db_col order -table u] [db_col {weird`name}] [db_alias [db_col {a"b}] {out col}]]
        dict get [db_compile [db_select [db_table users -as u] -expr {u."order", `weird``name`, "a""b" AS "out col"}] -dialect $dialect] sql
    } -result $expected
}

test expr-2.2 {Unicode quoted identifiers and aliases are preserved} -body {
    dict get [db_compile [db_select users -expr {"ηλικία" + 1 AS "来年"}]] sql
} -result {SELECT ("ηλικία" + :p1) AS "来年" FROM "users"}

test expr-2.3 {text is never evaluated as Tcl, even when it resembles a script} -body {
    set ::expr_unexpected 0
    set compiled [db_compile [db_select users -expr {'[set ::expr_unexpected 1]', '$variable; DROP TABLE users; --'}]]
    list $::expr_unexpected [dict get $compiled params]
} -cleanup {unset ::expr_unexpected} -result {0 {p1 {[set ::expr_unexpected 1]} p2 {$variable; DROP TABLE users; --}}}

test expr-2.4 {NULL and booleans become the existing typed nodes} -body {
    list [db_expr {NULL}] [db_expr {TRUE}] [db_expr {false}] [db_expr {name IS NOT NULL}]
} -result [list [db_null] [db_value 1 -type boolean] [db_value 0 -type boolean] [db_is_not_null [db_col name]]]

test expr-2.5 {named parameters are reusable and remain separate from SQL} -body {
    # db_where [db_select users] [db_or [db_ge [db_col age] [db_param minimum]] [db_eq [db_col score] [db_param minimum]]]
    set s [db_where [db_select users] -expr {age >= :minimum OR score = :minimum}]
    set compiled [db_compile $s -params {minimum 18}]
    list [dict get [db_compile $s] required] [dict get $compiled sql] [dict get $compiled params]
} -result {minimum {SELECT * FROM "users" WHERE (("age" >= :p1) OR ("score" = :p1))} {p1 18}}

test expr-2.6 {IN/NOT IN lists can contain literals, parameters and expressions} -body {
    set s [db_where [db_select users] -expr {id IN (1, :id, age + 1) AND name NOT IN ('A', 'B')}]
    dict get [db_compile $s -params {id 2}] sql
} -result {SELECT * FROM "users" WHERE (("id" IN (:p1, :p2, ("age" + :p3))) AND ("name" NOT IN (:p4, :p5)))}

test expr-2.7 {empty IN lists preserve the builder's defined semantics} -body {
    dict get [db_compile [db_where [db_select users] -expr {id IN () OR id NOT IN ()}]] sql
} -result {SELECT * FROM "users" WHERE ((1 = 0) OR (1 = 1))}

test expr-2.8 {NOT LIKE becomes a negated LIKE node} -body {
    expr {[db_expr {name NOT LIKE 'A%'}] eq [db_not [db_like [db_col name] [db_value A% -type text]]]}
} -result 1

test expr-2.9 {supported functions parse with nested arithmetic} -body {
    dict get [db_compile [db_select orders -expr {COUNT(*), SUM(price * amount), AVG(price), MIN(price), MAX(price)}]] sql
} -result {SELECT COUNT(*), SUM(("price" * "amount")), AVG("price"), MIN("price"), MAX("price") FROM "orders"}

test expr-3.1 {all contextual forms compose into a single statement} -body {
    # Equivalent builders: db_alias/db_count projections, db_eq for the join,
    # db_gt for filtering, db_col grouping and db_desc for ordering.
    set s [db_select [db_table users -as u] -expr {u.name, COUNT(o.id) AS total}]
    set s [db_join $s [db_table orders -as o] -expr {u.id = o.user_id} -type left]
    set s [db_where $s -expr {u.age > 18}]
    set s [db_group_by $s -expr {u.name}]
    set s [db_having $s -expr {COUNT(o.id) >= 2}]
    set s [db_order_by $s -expr {total DESC, u.name ASC}]
    dict get [db_compile $s] sql
} -result {SELECT "u"."name", COUNT("o"."id") AS "total" FROM "users" AS "u" LEFT JOIN "orders" AS "o" ON ("u"."id" = "o"."user_id") WHERE ("u"."age" > :p1) GROUP BY "u"."name" HAVING (COUNT("o"."id") >= :p2) ORDER BY "total" DESC, "u"."name" ASC}

test expr-3.2 {parsed and builder clauses can be mixed and preserve query branches} -body {
    set base [db_select users -columns {id name}]
    # set branch [db_where $base [db_gt [db_col age] [db_value 18 -type integer]]]
    set branch [db_where $base -expr {age > 18}]
    set branch [db_where $branch [db_eq [db_col active] [db_value 1 -type boolean]]]
    set branch [db_order_by [db_order_by $branch name] -expr {id DESC}]
    list [dict exists $base where] [dict get [db_compile $branch] sql]
} -result {0 {SELECT "id", "name" FROM "users" WHERE ("age" > :p1) AND ("active" = :p2) ORDER BY "name", "id" DESC}}

test expr-3.3 {write filters and RETURNING use the same parser} -body {
    # db_values [db_update users] [dict create age [db_add [db_col age] [db_value 1 -type integer]]] -expressions
    set update [db_values [db_update users] [dict create age [db_expr {age + 1}]] -expressions]
    set update [db_returning [db_where $update -expr {id = :id}] -expr {id, age AS new_age}]
    dict get [db_compile $update -params {id 7} -dialect postgresql] sql
} -result {UPDATE "users" SET "age" = ("age" + CAST(:p1 AS BIGINT)) WHERE ("id" = :p2) RETURNING "id", "age" AS "new_age"}

test expr-3.4 {a standalone expression can carry a projection alias or sort direction} -body {
    list [db_expr {COUNT(*) AS total}] [db_expr {age DESC}] [db_expr {u.*}]
} -result [list [db_alias [db_count] total] [db_desc [db_col age]] [db_star u]]

test expr-3.5 {legacy quoted column names still work without the explicit flag} -body {
    dict get [db_compile [db_select users -columns [list {age + 1}]]] sql
} -result {SELECT "age + 1" FROM "users"}

foreach {name expression} {
    empty {}
    missing-right {age >=}
    trailing-operator {a +}
    missing-paren {(age >= 18}
    extra-paren {age >= 18)}
    missing-operand {a * / b}
    dangling-not {NOT}
    empty-group {()}
    chained-comparison {a < b < c}
    missing-in-list {a IN}
    trailing-in-comma {a IN (1,)}
    missing-in-comma {a IN (1 2)}
    missing-in-close {a IN (1,2}
    unsupported-not {a NOT = 1}
    unsupported-is {active IS TRUE}
    unsupported-between {age BETWEEN 18 AND 30}
    unsupported-function {COALESCE(name, 'unknown')}
    empty-function {COUNT()}
    multi-argument-function {SUM(a, b)}
    distinct-function {COUNT(DISTINCT a)}
    quoted-function {"SUM"(a)}
    malformed-exponent {a = 1e+}
    bad-numeric-suffix {a = 123abc}
    hexadecimal {0x10}
    integer-overflow {9223372036854775808}
    integer-underflow {-9223372036854775809}
    missing-param-name {:}
    digit-param-name {:1abc}
    question-parameter {a = ?}
    dollar-parameter {a = $name}
    tcl-script {[set ::expr_unexpected 1]}
    unclosed-string {name = 'unfinished}
    unclosed-identifier {"unfinished}
    empty-identifier {""}
    unquoted-keyword {order}
    select-statement {SELECT name FROM users}
    sql-terminator {age > 18;}
    sql-injection {age > 18; DROP TABLE users}
    line-comment {age > 18 -- comment}
    block-comment {age > /*comment*/ 18}
    implicit-alias {age next_age}
    alias-as-string {age AS 'next_age'}
    standalone-list {id, name}
    overqualified-name {public.users.id}
    unsupported-cast {age::text}
    unsupported-concat {a || b}
    unsupported-modulo {a % 2}
    invalid-star {a + *}
    noncount-star {SUM(*)}
} {
    test expr-invalid-$name {unsupported or incomplete input is a located parse error} -body {
        set code [catch {db_expr $expression} message opts]
        list $code [lrange [dict get $opts -errorcode] 0 1] \
            [string match {expression parse error at character *: *} $message]
    } -result {1 {TPERSIST PARSE} 1}
}

foreach {name script} {
    where-alias {db_where [db_select users] -expr {age AS a}}
    having-order {db_having [db_select users] -expr {COUNT(*) DESC}}
    where-star {db_where [db_select users] -expr {*}}
    projection-order {db_select users -expr {age DESC}}
    order-alias {db_order_by [db_select users] -expr {age AS a}}
    order-star {db_order_by [db_select users] -expr {*}}
    group-order {db_group_by [db_select users] -expr {age DESC}}
    group-alias {db_group_by [db_select users] -expr {age AS a}}
    join-alias {db_join [db_select users] other -expr {id AS a}}
    return-order {db_returning [db_insert users] -expr {id DESC}}
    empty-projection {db_select users -expr {}}
    trailing-list-comma {db_select users -expr {id,}}
    leading-list-comma {db_order_by [db_select users] -expr {,id}}
    missing-list-comma {db_group_by [db_select users] -expr {id name}}
} {
    test expr-context-$name {each command accepts only its own expression grammar} -body {
        set code [catch $script message opts]
        list $code [lrange [dict get $opts -errorcode] 0 1]
    } -result {1 {TPERSIST PARSE}}
}

test expr-4.1 {diagnostic offsets count Tcl characters, including Unicode} -body {
    set expression {name = '世界' AND )}
    catch {db_expr $expression} message opts
    expr {[lindex [dict get $opts -errorcode] 2] == [string first ) $expression] + 1}
} -result 1

test expr-4.2 {quoted identifiers containing NUL are rejected} -body {
    catch {db_expr "\"a\x00b\""} message opts
    list [lrange [dict get $opts -errorcode] 0 1] [string match {*no NUL*} $message]
} -result {{TPERSIST PARSE} 1}

test expr-4.3 {grammar nesting is bounded before exhausting the native stack} -body {
    set expression [string repeat ( 110]a[string repeat ) 110]
    catch {db_expr $expression} message opts
    list [lrange [dict get $opts -errorcode] 0 1] [string match {*nesting exceeds*} $message]
} -result {{TPERSIST PARSE} 1}

test expr-4.4 {deep generated arithmetic trees obey the compiler's depth bound} -body {
    catch {db_expr [join [lrepeat 110 a] +]} message opts
    list [lrange [dict get $opts -errorcode] 0 1] [string match {*nesting exceeds*} $message]
} -result {{TPERSIST PARSE} 1}

test expr-4.5 {long AND lists stay flat and preserve every binding} -body {
    set query [db_where [db_select users] -expr [join [lrepeat 256 {age > 1}] { AND }]]
    dict size [dict get [db_compile $query] params]
} -result 256

test expr-4.6 {every truncated prefix either parses or returns a proper error} -body {
    set complete {SUM(price * qty) > :min AND name IN ('Alice', 'O''Brien')}
    set valid 1
    for {set i 0} {$i <= [string length $complete]} {incr i} {
        set code [catch {db_expr [string range $complete 0 [expr {$i - 1}]]} result opts]
        if {$code == 0} {
            if {![dict exists $result node]} { set valid 0; break }
        } elseif {$code != 1 || [lrange [dict get $opts -errorcode] 0 1] ne {TPERSIST PARSE}} {
            set valid 0; break
        }
    }
    set valid
} -result 1

foreach {name script} {
    expr-arity {db_expr}
    where-missing {db_where [db_select users] -expr}
    where-extra {db_where [db_select users] -expr {age > 1} extra}
    join-missing {db_join [db_select users] orders -expr}
    select-mixed {db_select users -expr {id} -columns name}
    order-mixed {db_order_by [db_select users] -expr {id} name}
    values-flag {db_values [db_update users] {age 1} -expr}
} {
    test expr-args-$name {invalid flag combinations do not silently change the statement} -body {
        catch $script
    } -result 1
}

::tcltest::cleanupTests
