package require tcltest 2
package require tpersist
namespace import ::tcltest::test
namespace import ::tpersist::db_*

test schema-1.1 {one schema describes all three database dialects} -body {
    set definition [db_define_table users [dict create \
        id {type integer primary_key 1 auto_increment 1} \
        name {type varchar length 80 not_null 1 unique 1} \
        enabled [dict create type boolean default [db_value 1 -type boolean]] \
        data {type binary}]]
    lmap dialect {sqlite postgresql mysql} { db_schema_sql $definition -dialect $dialect }
} -result [list \
    {CREATE TABLE "users" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "name" VARCHAR(80) NOT NULL UNIQUE, "enabled" BOOLEAN DEFAULT TRUE, "data" BLOB)} \
    {CREATE TABLE "users" ("id" INTEGER GENERATED BY DEFAULT AS IDENTITY, "name" VARCHAR(80) NOT NULL UNIQUE, "enabled" BOOLEAN DEFAULT TRUE, "data" BYTEA, PRIMARY KEY ("id"))} \
    {CREATE TABLE `users` (`id` INTEGER AUTO_INCREMENT, `name` VARCHAR(80) NOT NULL UNIQUE, `enabled` BOOLEAN DEFAULT TRUE, `data` BLOB, PRIMARY KEY (`id`)) ENGINE=InnoDB}]

test schema-1.2 {composite keys, uniqueness and foreign keys} -body {
    set definition [db_define_table memberships {team_id {type integer} user_id {type integer} role {type text}} \
        -primary_key {team_id user_id} -unique {{team_id role}} \
        -foreign_keys [list [dict create columns user_id table users referenced_columns id on_delete cascade]]]
    db_schema_sql $definition
} -result {CREATE TABLE "memberships" ("team_id" INTEGER, "user_id" INTEGER, "role" TEXT, PRIMARY KEY ("team_id", "user_id"), UNIQUE ("team_id", "role"), FOREIGN KEY ("user_id") REFERENCES "users" ("id") ON DELETE CASCADE)}

test schema-1.3 {table definitions can be used directly as statement sources} -body {
    set t [db_define_table users {id {type integer}} -schema public]
    dict get [db_compile [db_select $t] -dialect postgresql] sql
} -result {SELECT * FROM "public"."users"}

test schema-1.4 {default strings cannot escape their literal} -body {
    set t [db_define_table users [dict create name [dict create type text default [db_value {O'Brien'); DROP TABLE users; --} -type text]]]]
    db_schema_sql $t
} -result {CREATE TABLE "users" ("name" TEXT DEFAULT 'O''Brien''); DROP TABLE users; --')}

test schema-1.5 {backslashes in defaults have explicit dialect-safe representations} -body {
    set t [db_define_table paths [dict create path [dict create type text default [db_value {a\b} -type text]]]]
    list [db_schema_sql $t -dialect postgresql] [db_schema_sql $t -dialect mysql]
} -result [list {CREATE TABLE "paths" ("path" TEXT DEFAULT E'a\\b')} {CREATE TABLE `paths` (`path` TEXT DEFAULT X'615c62') ENGINE=InnoDB}]

test schema-1.6 {decimal precision and exact default are preserved} -body {
    db_schema_sql [db_define_table prices [dict create price [dict create type decimal precision 12 scale 2 default [db_value 1234567890.12 -type decimal]]]]
} -result {CREATE TABLE "prices" ("price" DECIMAL(12,2) DEFAULT 1234567890.12)}

foreach {label script pattern} {
    unknown-option {db_define_table users {id {type integer}} -typo 1} {*unknown table option*}
    unknown-column-option {db_define_table users {id {type integer sql DROP}}} {*unknown dictionary field*}
    unknown-type {db_define_table users {id {type raw}}} {*unsupported column type*}
    empty-columns {db_define_table users {}} {*at least one column*}
    empty-name {db_define_table {} {id {type integer}}} {*nonempty*}
    bad-length {db_define_table users {name {type varchar length {2); DROP}}}} {*length must*}
    missing-length {db_define_table users {name {type varchar}}} {*positive length*}
    bad-scale {db_define_table prices {price {type decimal precision 4 scale 5}}} {*scale*}
    duplicate-pk {db_define_table users {id {type integer primary_key 1}} -primary_key id} {*not both*}
    missing-pk-column {db_define_table users {id {type integer}} -primary_key absent} {*unknown constraint column*}
    composite-identity {db_define_table users {id {type integer primary_key 1 auto_increment 1} name {type text primary_key 1}}} {*composite*}
    noninteger-identity {db_define_table users {name {type text primary_key 1 auto_increment 1}}} {*integer primary key*}
    bad-default {db_schema_sql [db_define_table users [dict create id [dict create type integer default [db_col other]]]]} {*unknown dictionary field*}
    bad-number-default {db_schema_sql [db_define_table users [dict create id [dict create type integer default [db_value {1;DROP} -type integer]]]]} {*invalid integer default*}
    fake-definition {db_schema_sql {version 2 kind table_def name users columns {id {type integer}}}} {*version 1*}
} {
    test schema-invalid-$label {invalid schema definitions are rejected} -body $script -returnCodes error -match glob -result $pattern
}

::tcltest::cleanupTests
